{
  "name": "dsh-plugin-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin manager for DSH: lists third-party bundles in the settings page and toggles them through the home-layer managed block",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "resources",
    "templates",
    "cordis.patch.yml",
    "README.md"
  ]
}
